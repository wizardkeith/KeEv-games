{
  "version": "w1.1a-vfx-candidate",
  "source": "src/presentation/config.ts + feedback.ts + src/world.ts",
  "license": "Project-original, see LICENSE",
  "native": "Neutral parameters/triggers reusable; Unity URP materials/pools/time/input adapters and Android/iOS appearance NOT TESTED",
  "audio": "Existing original sale.wav, opt-in, playback volume .12; no new audio",
  "effects": {
    "selection": {
      "id": "fx.shelf.selection.v1",
      "trigger": "selected-slot-change",
      "duration": 180,
      "color": "#B59AC8",
      "stableAlpha": 0.62
    },
    "display": {
      "id": "fx.display.settle.v1",
      "trigger": "committed-display-delta",
      "duration": 200,
      "lift": 0.025
    },
    "sale": {
      "id": "fx.sale.receipt.v1",
      "trigger": "committed-eventSequence-delta",
      "duration": 700,
      "color": "#98AC99"
    },
    "stock": {
      "id": "fx.stock.receipt.v1",
      "trigger": "committed-purchase-delta",
      "duration": 600,
      "color": "#C3AF8E"
    },
    "support": {
      "id": "fx.support.receipt.v1",
      "trigger": "committed-recovery-total-delta",
      "duration": 700,
      "color": "#B59AC8"
    },
    "reveal": {
      "id": "fx.sample.open.v1",
      "trigger": "committed-revealed-false-to-true",
      "duration": 1100,
      "color": "#D5C4DF"
    },
    "dust": {
      "id": "fx.window.dust.v1",
      "trigger": "visible-high-quality",
      "capacity": 8,
      "lifetime": 12000,
      "ratePerSecond": 0.6666666666666666,
      "maxOpacity": 0.13,
      "size": 0.018
    },
    "policy": {
      "majorCapacity": 1,
      "queueCapacity": 0,
      "maxDt": 50,
      "hidden": "cancel transient; pause ambient; no catchup",
      "low": "no dust; static feedback",
      "minimal": "no dust, pose animation or transient 3D feedback",
      "reduced": "static poses and selection; immediate committed result"
    }
  }
}